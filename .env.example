# Server-side OpenAI credentials. Never commit the real value.
OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback
QUEUE_FILE_NAME=bunqueue.db
ARTIFACTS_DIR=artifacts
# Optional private directories used for resume and cover-letter generation.
# The built-in examples are used when these local directories do not exist.
CAREER_DATA_DIR=career-data
CAREER_PROFILES_DIR=profiles
# Optional taxonomy configuration. Defaults to config/skill-taxonomy.json.
SKILL_TAXONOMY_FILE=
OPENAI_JOB_PARSER_TIMEOUT_MS=90000
# Each specialized model falls back to OPENAI_MODEL_DEFAULT.
OPENAI_MODEL_DEFAULT="gpt-5-mini"
OPENAI_MODEL_JOB_PARSER="gpt-5-mini"
OPENAI_MODEL_CANDIDATE_FIT="gpt-5-mini"
OPENAI_MODEL_RESUME="gpt-5.6"
OPENAI_MODEL_COVER_LETTER="gpt-5.6-terra"
OPENAI_MODEL_DOCUMENT_REVIEW="gpt-5-mini"
