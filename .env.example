# Server-side OpenAI credentials. Never commit the real value.
OPENAI_API_KEY=
QUEUE_FILE_NAME=bunqueue.db
ARTIFACTS_DIR=artifacts
# For local development, copy profiles/candidate.profile.example.json to candidate.profile.json.
# For Fly.io, set CANDIDATE_PROFILE_JSON as a secret instead of committing personal details.
OPENAI_MODEL_DEFAULT=gpt-5-mini
OPENAI_MODEL_JOB_PARSER=gpt-5-mini
OPENAI_JOB_PARSER_TIMEOUT_MS=90000
OPENAI_MODEL_RESUME=gpt-5.6
OPENAI_MODEL_COVER_LETTER=gpt-5.5
