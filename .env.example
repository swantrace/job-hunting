# Server-side OpenAI credentials. Never commit the real value.
APP_AUTH_REQUIRED=false
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback
QUEUE_FILE_NAME=bunqueue.db
ARTIFACTS_DIR=artifacts
# Optional IMPORT-ONLY inputs. The running app reads career facts, directions,
# categories, personal skills and Base Resume versions from SQLite
# (DB_FILE_NAME), so it does NOT need either variable. They are read only by
# the explicit import/legacy-sync CLIs:
#   bun run career:import --source <dir>       # full dataset, dry-run default
#   bun run taxonomy:sync / skills:sync        # retired per-file legacy sync
#   bun run resume:import                      # stages Markdown for career:import
# Leave both empty to use the conventional `career-data/` location when present.
CAREER_DATA_DIR=
# Optional import-only directory for staged Base Resume Markdown. Defaults to
# CAREER_DATA_DIR/base-resumes, or ./career-data/base-resumes.
CAREER_BASE_RESUMES_DIR=
OPENAI_JOB_PARSER_TIMEOUT_MS=90000
# Each specialized model falls back to OPENAI_MODEL_DEFAULT.
OPENAI_MODEL_DEFAULT="gpt-5.6-terra"
OPENAI_MODEL_JOB_PARSER="gpt-5.6-terra"
OPENAI_MODEL_CANDIDATE_FIT="gpt-5.6-terra"
OPENAI_MODEL_RESUME="gpt-5.6-sol"
OPENAI_MODEL_COVER_LETTER="gpt-5.6-terra"
OPENAI_MODEL_DOCUMENT_REVIEW="gpt-5.6-terra"
