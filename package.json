{
  "name": "job-application-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "vite build --mode client && vite build",
    "start": "bun run db:migrate && cd dist && bun index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "bunqueue": "^2.8.32",
    "docxtemplater": "^3.69.0",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.8",
    "honox": "^0.1.46",
    "pizzip": "^3.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@flydotio/dockerfile": "^0.7.10",
    "@hono/vite-build": "^1.7.0",
    "@hono/vite-dev-server": "^0.25.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bun": "latest",
    "daisyui": "^5.1.28",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
